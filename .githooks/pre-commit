#!/usr/bin/env bash
set -e

# Format only staged Dart files.
STAGED_DART=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.dart$' || true)
if [ -n "$STAGED_DART" ]; then
  if command -v fvm >/dev/null 2>&1; then
    FMT="fvm dart format"
  else
    FMT="dart format"
  fi
  echo "$STAGED_DART" | xargs $FMT --page-width=80 --output=write
  echo "$STAGED_DART" | xargs git add
fi

# Block generated files from being staged in feature commits.
GEN=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '\.(freezed|g|config|module|gen)\.dart$' || true)
if [ -n "$GEN" ] && [ "$ALLOW_GEN_COMMIT" != "1" ]; then
  echo "Generated files detected in commit:"
  echo "$GEN"
  echo "Run with ALLOW_GEN_COMMIT=1 git commit ... to override."
  exit 1
fi
